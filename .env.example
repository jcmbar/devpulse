# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the client / never commit the real value.
# Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY

# App
# Public origin of THIS deployment (no trailing slash).
# Used as redirectTo for invite / password recovery emails ({{ .RedirectTo }}).
# On Render, set this to your service URL (e.g. https://devpulse.onrender.com).
# Also list `{NEXT_PUBLIC_SITE_URL}/auth/confirm` in Supabase → Authentication → Redirect URLs.
# Site URL in Supabase should point to production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Front-end inspection deterrent (NOT real security — authz stays on the server).
# Applied only under /app/gestor (Folha, fechamentos, dashboard, config).
# - unset: on in production, off in development
# - 1 / true / on: force enable (even locally)
# - 0 / false / off: force disable (even in production)
# NEXT_PUBLIC_INSPECTION_DETERRENT=0

# Sensitive action rate limits (per authenticated user; in-memory, resets on redeploy).
# Defaults: signed_url 30/60s · zip 5/300s · email_send 10/60s · email_test 1/60s · upload 20/60s
# SENSITIVE_RATE_SIGNED_URL_MAX=30
# SENSITIVE_RATE_SIGNED_URL_WINDOW_SEC=60
# SENSITIVE_RATE_ZIP_MAX=5
# SENSITIVE_RATE_ZIP_WINDOW_SEC=300
# SENSITIVE_RATE_EMAIL_SEND_MAX=10
# SENSITIVE_RATE_EMAIL_SEND_WINDOW_SEC=60
# SENSITIVE_RATE_EMAIL_TEST_MAX=1
# SENSITIVE_RATE_EMAIL_TEST_WINDOW_SEC=60
# SENSITIVE_RATE_UPLOAD_MAX=20
# SENSITIVE_RATE_UPLOAD_WINDOW_SEC=60

# Operational emails via ZeptoMail (Financeiro / RH / recibo colaborador).
# NOT used by Auth invite/reset (those stay on Supabase Auth).
#
# Default transport is HTTPS API (port 443) — required on Render Free, which
# blocks outbound SMTP on ports 25, 465 and 587.
# ZEPTOMAIL_TRANSPORT=api
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# Optional dedicated API token (falls back to ZEPTOMAIL_SMTP_PASSWORD):
# ZEPTOMAIL_API_TOKEN=your_zeptomail_send_mail_token
#
# SMTP only when the host allows egress (local or Render paid):
# ZEPTOMAIL_TRANSPORT=smtp
# ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.com
# ZEPTOMAIL_SMTP_PORT=587
# ZEPTOMAIL_SMTP_USER=emailapikey
# ZEPTOMAIL_SMTP_PASSWORD=your_zeptomail_smtp_password_or_api_token
# Temporary fallback only (prefer ZEPTOMAIL_SMTP_PASSWORD): SMTP_PASS
# Optional aliases: SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD
# OPERATIONAL_EMAIL_FROM_NAME=Athos Labs
# OPERATIONAL_EMAIL_FROM_EMAIL=contato@athoslabs.com.br
# OPERATIONAL_EMAIL_REPLY_TO=jefferson@athoslabs.com.br

# Jira Cloud (API tokens — server-only). Reference these names from jira_integrations.api_token_secret_ref.
# Create tokens at https://id.atlassian.com/manage-profile/security/api-tokens
# Example:
# JIRA_TOKEN_PRIME=your-atlassian-api-token
# Optional override for JQL datetime zone if /myself.timeZone is missing (IANA):
# JIRA_JQL_TIMEZONE=America/Sao_Paulo
# Auto-sync cooldown when opening /app/gestor (minutes). Default 60.
# JIRA_AUTO_SYNC_COOLDOWN_MINUTES=60
